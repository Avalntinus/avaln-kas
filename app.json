{
  "expo": {
    "name": "Avaln Kas",
    "slug": "avaln-kas",
    "version": "0.5.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "avalnkas",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAFAF8",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.avaln.kas",
      "versionCode": 6
    },
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#12100E",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Budget",
              "label": "Avaln Kas",
              "description": "Sisa hari ini dan sisa minggu ini.",
              "minWidth": "180dp",
              "minHeight": "90dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/budget.png",
              "maxResizeWidth": "520dp",
              "maxResizeHeight": "320dp"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.avaln.kas",
      "supportsTablet": true
    }
  }
}
